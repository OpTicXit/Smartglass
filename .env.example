# PLANTILLA de variables de entorno de SmartGlass. NO contiene secretos reales.
# Copialo a .env en la raiz del repo y rellena los valores: Spring Boot lee .env al arrancar
# en local (spring.config.import en application.properties), desde VS Code o desde backend/ con mvnw.
# .env esta en .gitignore y en .dockerignore y no debe subirse nunca.

# --- Obligatorias (sin ellas la app no arranca: Could not resolve placeholder) ---
MYSQL_PASSWORD=tu_password_local
# HMAC-SHA256: minimo 32 bytes. Usa un valor FIJO durante la demo (si cambia, los JWT emitidos dejan de valer).
JWT_SECRET=cambiar-este-secreto-min-32-bytes-xxxxxxxx
GOOGLE_CLIENT_ID=tu-id-de-cliente.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente

# --- Opcionales ---
# Usuario de MySQL (por defecto: root)
MYSQL_USER=root
# Solo la primera vez: crea el admin inicial (usuario "admin") si aun no existe
ADMIN_PASSWORD=
# Correo que envia los codigos para recuperar la contrasena. Sin el, el login no ofrece la opcion.
# Con Gmail: verificacion en dos pasos + contrasena de aplicacion (no la contrasena normal).
MAIL_USERNAME=
MAIL_PASSWORD=

# --- T6: despliegue (Render o Railway). En local no hacen falta: hay valores por defecto ---
# Dejalas comentadas: una linea vacia como MYSQL_URL= pisa el valor por defecto y la app no arranca.
# Perfil de produccion (cookie segura, logs sobrios, cache de estaticos)
# SPRING_PROFILES_ACTIVE=prod
# Puerto: lo asigna la plataforma
# PORT=50500
# MySQL gestionado
# MYSQL_URL=jdbc:mysql://HOST:PUERTO/smartglass_db?sslMode=REQUIRED&serverTimezone=UTC
# MongoDB Atlas con el nombre de la base
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/smartglass?retryWrites=true&w=majority
# Carpeta persistente de fotos subidas (volumen de la plataforma)
# UPLOADS_DIR=
# Conexiones simultaneas a MySQL en produccion (por defecto 5)
# DB_POOL=5

# --- Para practicar ---
# Datos de demostracion (DemoDatosSeeder): true para cargarlos una sola vez en una instalacion nueva
DEMO_DATOS=
# Contrasena de los clientes de ejemplo (opcional; sin ella nadie puede entrar con esas cuentas)
DEMO_PASSWORD=
